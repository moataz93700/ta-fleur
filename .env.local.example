# TA FLEUR — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# NE JAMAIS committer .env.local

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SHOPIFY HEADLESS (Storefront API)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=votre-boutique.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=votre_token_storefront_public

# Shopify Admin API (server-side uniquement)
SHOPIFY_ADMIN_ACCESS_TOKEN=votre_token_admin_secret
SHOPIFY_WEBHOOK_SECRET=votre_secret_webhook

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SITE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NEXT_PUBLIC_SITE_URL=https://tafleur.fr

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ANALYTICS (à configurer plus tard)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXX
